# Application Server & URL
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# MySQL Database Connection (Leave DB_HOST empty in preview to use local transactional store)
DB_HOST=
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shadhall_booking

# Security Secrets (Use long random strings in production)
JWT_SECRET="replace_with_64_char_random_hex_secret"
JWT_REFRESH_SECRET="replace_with_another_64_char_random_hex_secret"
CSRF_SECRET="replace_with_csrf_secret"

# Optional Seed Admin Credentials (for initial bootstrap only)
ADMIN_SEED_EMAIL="admin@aureliahall.com"
ADMIN_SEED_PASSWORD="AdminSecure123!"
